# Plantilla de variables de entorno de MateCode Task Manager.
# Copiá este archivo como `.env` (que Git ignora) y completá los valores reales localmente.
# Nunca subas `.env` ni valores reales a este archivo.
#
# Firebase (config pública del cliente; no son secretos de servidor, pero igual
# se mantienen fuera del repositorio). Se obtienen desde la consola de Firebase,
# en Configuración del proyecto > Tus apps > Config del SDK.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Service account de Firebase Admin (solo servidor, usada por la Vercel Function para verificar
# el idToken de quien pide el envío del resumen por email). Se genera en la consola de Firebase,
# en Configuración del proyecto > Cuentas de servicio > Generar nueva clave privada. A propósito
# NO llevan el prefijo VITE_: Vite solo expone al bundle del cliente las variables que empiezan
# con ese prefijo, así que estas nunca llegan al frontend. FIREBASE_ADMIN_PRIVATE_KEY conserva los
# saltos de línea como "\n" literales al pegarla acá; el código los convierte de vuelta.
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=

# Las variables de AWS SES se agregarán al implementar el envío real de emails.
