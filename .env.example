# Plantilla de variables de entorno de MateCode Task Manager.
# Copiá este archivo como `.env` (que Git ignora) y completá los valores reales localmente.
# Nunca subas `.env` ni valores reales a este archivo.
#
# Firebase (config pública del cliente; no son secretos de servidor, pero igual
# se mantienen fuera del repositorio). Se obtienen desde la consola de Firebase,
# en Configuración del proyecto > Tus apps > Config del SDK.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Service account de Firebase Admin (solo servidor, usada por la Vercel Function para verificar
# el idToken de quien pide el envío del resumen por email). Se genera en la consola de Firebase,
# en Configuración del proyecto > Cuentas de servicio > Generar nueva clave privada. A propósito
# NO llevan el prefijo VITE_: Vite solo expone al bundle del cliente las variables que empiezan
# con ese prefijo, así que estas nunca llegan al frontend. FIREBASE_ADMIN_PRIVATE_KEY conserva los
# saltos de línea como "\n" literales al pegarla acá; el código los convierte de vuelta.
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=

# AWS SES (solo servidor, usadas por la Vercel Function para enviar el resumen por email).
# Creá un usuario IAM con permisos mínimos (solo ses:SendEmail/ses:SendRawEmail sobre tu
# identidad verificada), no uses credenciales de administrador. A propósito NO se llaman
# AWS_REGION/AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY: las Vercel Functions corren sobre AWS
# Lambda, que ya define esas variables con las credenciales del rol de ejecución de la
# plataforma (no las nuestras) — usar esos nombres haría que el SDK tome las credenciales
# equivocadas en producción. Por eso usamos nombres propios y se los pasamos al cliente de
# forma explícita en el código. SES_SENDER_EMAIL tiene que ser una identidad (email o dominio)
# verificada en SES; mientras la cuenta esté en modo sandbox, el destinatario también debe
# estar verificado.
SES_REGION=
SES_ACCESS_KEY_ID=
SES_SECRET_ACCESS_KEY=
SES_SENDER_EMAIL=
