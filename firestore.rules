rules_version = '2';

// Reglas de seguridad de Cloud Firestore para MateCode Task Manager.
//
// Este archivo es la fuente de verdad de las reglas y refleja lo que está
// publicado en la consola de Firebase. Si se necesita cambiarlas, primero se
// edita acá y después se publica el mismo contenido en la consola
// (Firestore Database > Reglas).
//
// Objetivo: cada usuario autenticado solo puede leer, crear, editar o
// eliminar sus propias tareas (nunca las de otro usuario), y nadie sin
// autenticar puede acceder a ningún dato.
service cloud.firestore {
  match /databases/{database}/documents {
    // El usuario hizo la petición autenticado.
    function isSignedIn() {
      return request.auth != null;
    }

    // El documento ya existente (antes del cambio) pertenece al usuario.
    function isOwnerExisting() {
      return request.auth.uid == resource.data.userId;
    }

    // El documento que se está por escribir pertenece al usuario logueado.
    // Se usa tanto en `create` como en `update`, para evitar que alguien
    // reasigne el `userId` de una tarea propia a otro usuario.
    function isOwnerIncoming() {
      return request.auth.uid == request.resource.data.userId;
    }

    // El documento trae los campos mínimos requeridos por el modelo de Task.
    function hasValidShape() {
      return request.resource.data.keys().hasAll(["title", "completed", "userId"]);
    }

    match /tasks/{taskId} {
      allow read, delete: if isSignedIn() && isOwnerExisting();
      allow create:       if isSignedIn() && isOwnerIncoming() && hasValidShape();
      allow update:       if isSignedIn() && isOwnerExisting() && isOwnerIncoming();
    }
  }
}
